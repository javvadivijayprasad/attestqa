node_modules/
dist/
.aqa/

# VS Code extension: compiled output and the packaged bundle. The .vsix is a
# build artefact — it belongs on the Marketplace and on a GitHub release, not
# in the history, where it would be a binary blob per version.
extension/out/
*.vsix

.env
.env.*
!.env.example
*.log
coverage/
.DS_Store
Thumbs.db

# Generated by a sandbox run
examples/sandbox/tests/
examples/sandbox/test-results/
examples/sandbox/playwright-report/
examples/sandbox/.aqa-report/

# Generated by a live run at the repo root: the Playwright MCP server's output
# directory (screenshots, traces, downloads) and a suite run whose cwd was the
# repo rather than the workspace. Evidence of a run belongs in .aqa/, not here.
.playwright-mcp/
test-results/
playwright-report/

# bdd2pw output when a run's workspace is the repo root. `test/` (singular) is
# this package's own suite and IS committed; `tests/` and `pages/` are not.
/tests/
/pages/

# Scratch repo for bdd2pw dry runs: `bdd2pw analyze`/`scaffold` writes Page
# Objects and a spec here while we measure how many Gherkin steps bind. It is
# measurement output, regenerated on demand.
.scratch-bdd2pw/

# Playwright report written by the pw adapter during a run, and the folder files
# are moved to instead of deleted. Both are working state, never source.
.aqa-report/
_to_delete/

# local editor settings (the attestqa extension reads aqa.* from here)
.vscode/
