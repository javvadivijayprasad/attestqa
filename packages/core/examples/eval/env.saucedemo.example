# Copy to packages/core/.env.saucedemo (git-ignored) and fill in. Used as --env .env.saucedemo,.env
# Test accounts only. Never commit the filled-in copy.
AZURE_DEVOPS_PROJECT=attestqa-saucedemo
AQA_APP_URL=https://www.saucedemo.com
# the standard demo user, and the fault users the linked-bug stories need
AQA_APP_USER=
AQA_APP_PASS=
AQA_LOCKED_USER=
AQA_PROBLEM_USER=
AQA_ERROR_USER=
