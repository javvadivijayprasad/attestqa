# Copy to .env (git-ignored). Never commit real values; never paste them into chat.
# The model credential — ONE of these, matching agent.model.provider in the config.
# anthropic (the default) reads ANTHROPIC_API_KEY; openai reads OPENAI_API_KEY;
# azure-openai reads AZURE_OPENAI_API_KEY; local needs none.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AQA_GATEWAY_API_KEY=        # provider gateway, when your gateway takes a key
AQA_MODEL=claude-sonnet-4-6
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/jvijayprasad
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_PROJECT=agentic-qa-sandbox

# Jira (optional) — instead of, or as well as, Azure DevOps. A story given as a
# Jira key (SHOP-12) is read from here. Read-only except creating a Bug, which a
# person approves. Cloud: email + API token. Data Center: a personal access token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# JIRA_PAT=
# JIRA_API_VERSION=3          # 3 for Cloud (default with an API token), 2 for Data Center
# JIRA_AC_FIELD=customfield_10042   # if acceptance criteria live in a custom field
AQA_SANDBOX=1
# Optional: pin MCP server versions once docs/tools-observed.md records them
# AQA_ADO_MCP_VERSION=
# AQA_PLAYWRIGHT_MCP_VERSION=

# Application under test. Read by the workspace's playwright.config.ts as baseURL
# and credentials — never hard-coded into a spec, and never put in the work item.
# Sandbox target: OWASP Juice Shop, `docker run --rm -d -p 3100:3000 bkimminich/juice-shop`
AQA_APP_URL=http://localhost:3100
AQA_APP_USER=
AQA_APP_PASS=

# bdd2pw's LLM fallback for Gherkin steps its rule table cannot bind (agent.llm_fallback
# in the config turns it on). The sidecar sanitises every prompt before it leaves the
# machine and bdd2pw fails closed without it, so the provider is only ever passed to the
# generator when this is set. Start the sidecar first; ANTHROPIC_API_KEY above is the key
# bdd2pw uses — one .env for the runtime and the generator both.
AI_GOVERNANCE_URL=http://127.0.0.1:4900
